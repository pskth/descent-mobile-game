<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sky_gradient"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Title & Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DESCENT"
        android:textColor="@android:color/white"
        android:textSize="48sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="THE SKY IS YOUR BATTLEFIELD"
        android:textColor="#E0F2FE"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="64dp"
        android:gravity="center" />

    <!-- Play Now Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlayNow"
        android:layout_width="240dp"
        android:layout_height="64dp"
        android:text="PLAY NOW"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:backgroundTint="#EB3746"
        app:cornerRadius="16dp" />

    <!-- Bottom Section for Past Highest Scores -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        app:cardBackgroundColor="#33000000"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAST HIGHEST SCORES"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvHighScores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No scores yet. Play to set a record!"
                android:textColor="#E0F2FE"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
